(local reviewer (require :reviewer))
(local reviser (require :reviser))
(local meta (data.parse "{\"intent\":\"Bounded review, conditional revision, review. max_revisions counts mutations, not reviews.\",\"input_schema\":{\"type\":\"object\",\"required\":[\"workspace\",\"task\",\"max_revisions\"],\"properties\":{\"workspace\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"max_revisions\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":3}}},\"output_schema\":{\"type\":\"object\",\"required\":[\"status\",\"revisions\"],\"properties\":{\"status\":{\"type\":\"string\"},\"revisions\":{\"type\":\"integer\"}}}}"))
(fn context [input n findings]
  (local out {})
  (each [key value (data.iter input)] (tset out key value))
  (tset out :revision n)
  (when findings (tset out :findings findings))
  (data.object out))
(fn with-stages [input review revise]
  (local limit (data.scalar (data.get input :max_revisions)))
  (assert (and (= (math.type limit) :integer) (>= limit 0) (<= limit 3)) "max_revisions must be 0..3")
  (var n 0)
  (var terminal nil)
  (while (not terminal)
    (local reviewed (review (context input n nil)))
    (if (not (data.scalar (data.get reviewed :ok)))
        (set terminal (data.pack {:status (data.get reviewed :status) :revisions n :last reviewed}))
        (= (data.scalar (data.get (data.get reviewed :answer) :verdict)) :approved)
        (set terminal (data.pack {:status :approved :revisions n :last reviewed}))
        (>= n limit)
        (set terminal (data.pack {:status :attempts_exhausted :revisions n :last reviewed}))
        (let [revised (revise (context input (+ n 1) (data.get (data.get reviewed :answer) :findings)))]
          (set n (+ n 1))
          (when (not (data.scalar (data.get revised :ok)))
            (set terminal (data.pack {:status (data.get revised :status) :revisions n :last revised}))))))
  terminal)
(fn run [input] (with-stages input reviewer.run reviser.run))
{:meta meta :run run :with-stages with-stages :context context}
