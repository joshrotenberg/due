{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Due trace record version 1",
  "description": "One JSONL record from a Due trace. Validate each line separately. Default metadata is content-free; optional detail excerpts require explicit opt-in. Sequence gaps and dropped_records report delivery loss; native activity units are not comparable across providers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "provider",
    "seq",
    "elapsed_ms",
    "timestamp_ms",
    "idle_ms",
    "event",
    "activities_started",
    "activities_completed",
    "activities_failed",
    "messages",
    "dropped_records"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "idle_ms": {
      "type": "integer",
      "minimum": 0
    },
    "activities_started": {
      "type": "integer",
      "minimum": 0
    },
    "activities_completed": {
      "type": "integer",
      "minimum": 0
    },
    "activities_failed": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "integer",
      "minimum": 0
    },
    "dropped_records": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "activity_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "message_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "event": {
      "enum": [
        "run_started",
        "prompt_ready",
        "process_started",
        "session_started",
        "turn_started",
        "turn_completed",
        "turn_failed",
        "provider_error",
        "cancel_requested",
        "thinking_started",
        "response_started",
        "activity_started",
        "activity_completed",
        "activity_detail",
        "message_completed",
        "heartbeat",
        "run_finished"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "pgid": {
      "type": "integer",
      "minimum": 1
    },
    "resumed": {
      "type": "boolean"
    },
    "ephemeral": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "activity": {
      "enum": [
        "command",
        "file_change",
        "mcp_call",
        "web_search",
        "plan_update",
        "status_update",
        "tool_call",
        "unknown"
      ]
    },
    "activity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "unknown",
        "timed_out",
        "planned"
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "truncated"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 240
        },
        "truncated": {
          "type": "boolean"
        },
        "source": {
          "const": "permission_check_input",
          "description": "Bash input from a native Claude denial, which may reflect a hook rewrite."
        }
      },
      "description": "Opt-in content excerpt, capped at 240 UTF-8 bytes after terminal-control escaping. Absent by default. Excerpts may contain sensitive provider content."
    },
    "state": {
      "const": "waiting"
    },
    "scope": {
      "const": "execution"
    },
    "error_kind": {
      "enum": [
        "invalid_input",
        "authentication",
        "max_turns",
        "max_budget",
        "configuration",
        "session_not_found",
        "unsupported",
        "provider",
        "protocol",
        "io",
        "timeout",
        "cancelled",
        "not_found"
      ]
    },
    "provider_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "description": "Native counters only. Cache inclusion and overlap differ by provider; totals are never inferred."
    },
    "cost_usd": {
      "type": "number"
    }
  },
  "oneOf": [
    {
      "required": [
        "resumed",
        "ephemeral",
        "dry_run"
