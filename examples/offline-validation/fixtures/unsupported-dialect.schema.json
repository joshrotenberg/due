{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "verdict"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "approve",
        "request_changes"
      ]
    }
  }
}
