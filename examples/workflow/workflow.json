{
  "schema_version": 1,
  "entry": "review.rhai",
  "input_schema": "input.schema.json",
  "output_schema": "answer.schema.json",
  "max_runs": 5,
  "max_concurrency": 2,
  "profiles": {
    "reader": {
      "request": {
        "schema_version": 1,
